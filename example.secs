let simpledict be {Hell: "you"; Please: "go"}
out(simpledict & simpledict["Hell"])

append(simpledict, "Strict", 5)
out(simpledict & simpledict["Strict"])

let mylist be [1, 2, 3]
out(mylist)

append(mylist, 5)
out(mylist)

let PacketList be sniff :: iface "enp3s0" count 10 filter "ALL" delay 1
out(PacketList)