let mylist be [1,2,3]
out(mylist)

let mylist be [2,3,4]
out(mylist)
out(mylist[0])

for i in mylist {
    out(i)
}

FUNCTION hello (name) {
    out(name)
}

hello("arshia")

FUNCTION goodbye(name) {
    GIVE "Goodbye"
}

let good be goodbye("Atsh")
out(good)

//this is a test for how comment work let me be me

FUNCTION add(a, b) {
    GIVE a + b
}

let result be add(2,3)
out(result)

out("hello" & good)

let openPorts be SCAN "192.168.56.103" ports 1 :: 1000 delay 0.5
out(openPorts)

let foundList be FIND "form" IN "http://192.168.56.103/admin"
out(foundList)